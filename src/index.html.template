<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0f172a">
    <meta name="description" content="Komari 主题市场 - 自动同步上游仓库，国内 CDN 加速访问">
    <title>Komari Market - 主题市场</title>
    <style>
        /* ========== 设计系统 - 暗色 ========== */
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-light: #a5b4fc;
            --primary-glow: rgba(99, 102, 241, 0.4);
            --secondary: #06b6d4;
            --accent: #f472b6;
            --success: #22c55e;
            --warning: #f59e0b;
            --bg: #0b1120;
            --bg-soft: #0f172a;
            --surface: rgba(30, 41, 59, 0.7);
            --surface-hover: rgba(30, 41, 59, 0.9);
            --surface-solid: #1e293b;
            --text: #f8fafc;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            --text-dim: #64748b;
            --border: rgba(148, 163, 184, 0.12);
            --border-hover: rgba(148, 163, 184, 0.25);
            --border-active: rgba(99, 102, 241, 0.5);
            --shadow-sm: 0 2px 8px -2px rgba(0, 0, 0, 0.3);
            --shadow-md: 0 8px 24px -4px rgba(0, 0, 0, 0.4);
            --shadow-lg: 0 24px 48px -12px rgba(0, 0, 0, 0.5);
            --shadow-glow: 0 0 40px -10px var(--primary-glow);
            --radius-xs: 6px;
            --radius-sm: 10px;
            --radius: 14px;
            --radius-lg: 20px;
            --radius-full: 9999px;
            --space-xs: 8px;
            --space-sm: 12px;
            --space-md: 20px;
            --space-lg: 32px;
            --space-xl: 48px;
            --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
            --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
            --theme-color: #0f172a;
        }

        /* ========== 设计系统 - 亮色 ========== */
        :root[data-theme="light"] {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-light: #4f46e5;
            --primary-glow: rgba(99, 102, 241, 0.2);
            --bg: #f8fafc;
            --bg-soft: #f1f5f9;
            --surface: rgba(255, 255, 255, 0.85);
            --surface-hover: rgba(255, 255, 255, 0.95);
            --surface-solid: #ffffff;
            --text: #0f172a;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --text-dim: #94a3b8;
            --border: rgba(15, 23, 42, 0.08);
            --border-hover: rgba(15, 23, 42, 0.15);
            --border-active: rgba(99, 102, 241, 0.4);
            --shadow-sm: 0 2px 8px -2px rgba(0, 0, 0, 0.06);
            --shadow-md: 0 8px 24px -4px rgba(0, 0, 0, 0.08);
            --shadow-lg: 0 24px 48px -12px rgba(0, 0, 0, 0.12);
            --shadow-glow: 0 0 30px -10px rgba(99, 102, 241, 0.15);
            --theme-color: #f8fafc;
        }

        /* 亮色主题特殊覆盖 */
        :root[data-theme="light"] .brand-text h1 {
            background: linear-gradient(135deg, #0f172a 0%, var(--primary) 100%);
            -webkit-background-clip: text;
            background-clip: text;
        }
        :root[data-theme="light"] body::before {
            background:
                radial-gradient(ellipse 80% 60% at 15% 10%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse 70% 50% at 85% 90%, rgba(6, 182, 212, 0.06) 0%, transparent 50%),
                radial-gradient(ellipse 60% 40% at 50% 50%, rgba(244, 114, 182, 0.04) 0%, transparent 60%);
        }
        :root[data-theme="light"] .logo {
            box-shadow: 0 8px 24px -6px rgba(99, 102, 241, 0.25), inset 0 1px 0 rgba(255,255,255,0.3);
        }
        :root[data-theme="light"] .theme-preview-wrap {
            background: linear-gradient(135deg, #e2e8f0 0%, #f1f5f9 100%);
        }
        :root[data-theme="light"] .theme-version {
            background: rgba(255, 255, 255, 0.85);
            border-color: rgba(15, 23, 42, 0.08);
            color: var(--text);
        }
        :root[data-theme="light"] .preview-overlay {
            background: linear-gradient(to top, rgba(248, 250, 252, 0.9) 0%, transparent 60%);
        }
        :root[data-theme="light"] .preview-fallback { color: var(--text-dim); }
        :root[data-theme="light"] .skeleton-preview,
        :root[data-theme="light"] .skeleton-line {
            background: linear-gradient(90deg, #e2e8f0 0%, #f1f5f9 50%, #e2e8f0 100%);
            background-size: 200% 100%;
        }
        :root[data-theme="light"] ::-webkit-scrollbar-track { background: var(--bg-soft); }
        :root[data-theme="light"] ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-color: var(--bg);
        }
        :root[data-theme="light"] ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        :root[data-theme="light"] ::selection { background: rgba(99, 102, 241, 0.2); color: var(--text); }
        :root[data-theme="light"] .btn-primary { box-shadow: 0 4px 12px -2px rgba(99, 102, 241, 0.25); }
        :root[data-theme="light"] .btn-secondary { background: rgba(15, 23, 42, 0.03); }
        :root[data-theme="light"] .btn-secondary:hover { background: rgba(15, 23, 42, 0.06); }
        :root[data-theme="light"] .toast { background: #fff; }
        :root[data-theme="light"] .back-to-top { background: #fff; }
        :root[data-theme="light"] .data-source {
            background: linear-gradient(135deg, rgba(99,102,241,0.05) 0%, rgba(6,182,212,0.03) 50%, rgba(244,114,182,0.02) 100%);
            border-color: rgba(99,102,241,0.12);
        }
        :root[data-theme="light"] .data-source:hover { border-color: rgba(99,102,241,0.25); box-shadow: 0 0 40px -12px rgba(99,102,241,0.1); }
        :root[data-theme="light"] .data-source::before { background: radial-gradient(circle, rgba(99,102,241,0.04) 0%, transparent 70%); }
        :root[data-theme="light"] .data-source::after { background: radial-gradient(circle, rgba(6,182,212,0.03) 0%, transparent 70%); }
        :root[data-theme="light"] .data-source-icon { box-shadow: 0 4px 12px -2px rgba(99,102,241,0.2); }
        :root[data-theme="light"] .data-source-url { background: #fff; border-color: rgba(15,23,42,0.1); }
        :root[data-theme="light"] .btn-copy { box-shadow: 0 4px 12px -2px rgba(99, 102, 241, 0.25); }
        :root[data-theme="light"] .data-source-dot { box-shadow: 0 0 6px var(--success); }

        /* ========== 基础重置 ========== */
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            font-feature-settings: 'cv11', 'ss01';
            font-variation-settings: 'opsz' 32;
        }

        /* 背景光晕 */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 15% 10%, rgba(99, 102, 241, 0.18) 0%, transparent 50%),
                radial-gradient(ellipse 70% 50% at 85% 90%, rgba(6, 182, 212, 0.14) 0%, transparent 50%),
                radial-gradient(ellipse 60% 40% at 50% 50%, rgba(244, 114, 182, 0.08) 0%, transparent 60%);
            pointer-events: none;
            z-index: -1;
            animation: bgShift 20s ease-in-out infinite alternate;
        }
        @keyframes bgShift {
            0% { transform: scale(1) rotate(0deg); }
            100% { transform: scale(1.1) rotate(2deg); }
        }

        /* 滚动条 */
        ::-webkit-scrollbar { width: 10px; height: 10px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb {
            background: var(--surface-solid);
            border-radius: var(--radius-full);
            border: 2px solid var(--bg);
        }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-dim); }

        /* 文字选中 */
        ::selection { background: var(--primary-glow); color: var(--text); }

        /* ========== 容器 ========== */
        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 32px 24px 80px;
        }

        /* ========== 头部 ========== */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--space-xl);
            padding-bottom: var(--space-lg);
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
            gap: var(--space-md);
        }
        .brand {
            display: flex;
            align-items: center;
            gap: var(--space-md);
        }
        .logo {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: var(--radius);
            display: grid;
            place-items: center;
            font-size: 28px;
            box-shadow: 0 12px 32px -8px var(--primary-glow), inset 0 1px 0 rgba(255,255,255,0.2);
            position: relative;
            animation: logoPulse 4s ease-in-out infinite;
        }
        @keyframes logoPulse {
            0%, 100% { box-shadow: 0 12px 32px -8px var(--primary-glow), inset 0 1px 0 rgba(255,255,255,0.2); }
            50% { box-shadow: 0 12px 40px -4px var(--primary-glow), inset 0 1px 0 rgba(255,255,255,0.2); }
        }
        .brand-text h1 {
            font-size: 1.85rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            background: linear-gradient(135deg, #fff 0%, var(--primary-light) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.2;
        }
        .brand-text p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin-top: 4px;
        }
        .data-source {
            position: relative;
            background: linear-gradient(135deg, rgba(99,102,241,0.1) 0%, rgba(6,182,212,0.08) 50%, rgba(244,114,182,0.06) 100%);
            border: 1px solid rgba(99,102,241,0.18);
            border-radius: var(--radius-lg);
            padding: 28px var(--space-lg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            overflow: hidden;
            transition: border-color 0.3s, box-shadow 0.3s;
        }
        .data-source:hover {
            border-color: rgba(99,102,241,0.35);
            box-shadow: 0 0 60px -16px rgba(99,102,241,0.25);
        }
        .data-source::before {
            content: '';
            position: absolute;
            top: -60%;
            right: -10%;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(99,102,241,0.1) 0%, transparent 70%);
            pointer-events: none;
        }
        .data-source::after {
            content: '';
            position: absolute;
            bottom: -40%;
            left: -5%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(6,182,212,0.08) 0%, transparent 70%);
            pointer-events: none;
        }
        .data-source-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
        }
        .data-source-icon {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-sm);
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: grid;
            place-items: center;
            flex-shrink: 0;
            box-shadow: 0 4px 12px -2px rgba(99,102,241,0.4);
        }
        .data-source-icon svg { width: 20px; height: 20px; color: #fff; }
        .data-source-meta { flex: 1; }
        .data-source-title {
            font-size: 1.05rem;
            color: var(--text);
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .data-source-dot {
            width: 7px;
            height: 7px;
            background: var(--success);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--success);
            animation: pulse 2s ease-in-out infinite;
            flex-shrink: 0;
        }
        .data-source-desc {
            font-size: 0.82rem;
            color: var(--text-muted);
            margin-top: 2px;
        }
        .data-source-row {
            display: flex;
            align-items: center;
            gap: var(--space-sm);
            position: relative;
        }
        .data-source-url {
            flex: 1;
            min-width: 0;
            background: var(--bg-soft);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 13px 16px;
            color: var(--text);
            font-family: 'JetBrains Mono', 'SF Mono', Consolas, monospace;
            font-size: 0.9rem;
            font-weight: 500;
            white-space: nowrap;
            overflow-x: auto;
            scrollbar-width: none;
            user-select: all;
            transition: border-color 0.2s;
        }
        .data-source-url:hover { border-color: var(--border-hover); }
        .data-source-url::-webkit-scrollbar { display: none; }
        .btn-copy {
            flex-shrink: 0;
            height: 48px;
            padding: 0 24px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: #fff;
            border: none;
            border-radius: var(--radius-sm);
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.25s var(--ease-smooth);
            box-shadow: 0 4px 16px -4px rgba(99,102,241,0.4);
        }
        .btn-copy:hover { transform: translateY(-2px); box-shadow: 0 6px 24px -4px rgba(99,102,241,0.5); }
        .btn-copy:active { transform: translateY(0); }
        .btn-copy.copied {
            background: linear-gradient(135deg, var(--success) 0%, #16a34a 100%);
            box-shadow: 0 4px 16px -4px rgba(34,197,94,0.4);
        }
        .btn-copy svg { width: 16px; height: 16px; }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* ========== 主题切换 ========== */
        .theme-toggle {
            width: 44px;
            height: 44px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            cursor: pointer;
            display: grid;
            place-items: center;
            color: var(--text-secondary);
            transition: all 0.3s var(--ease-smooth);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 0;
        }
        .theme-toggle:hover {
            border-color: var(--border-hover);
            background: var(--surface-hover);
            color: var(--text);
            transform: translateY(-1px);
        }
        .theme-toggle svg {
            width: 20px;
            height: 20px;
            transition: transform 0.4s var(--ease-spring);
        }
        .theme-toggle:hover svg { transform: rotate(30deg); }
        .icon-sun, .icon-moon { display: none; }
        :root:not([data-theme="light"]) .icon-moon { display: block; }
        :root:not([data-theme="light"]) .icon-sun { display: none; }
        :root[data-theme="light"] .icon-sun { display: block; }
        :root[data-theme="light"] .icon-moon { display: none; }

        /* ========== 统计卡片 ========== */
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: var(--space-md);
            margin-bottom: var(--space-xl);
        }
        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: var(--space-md) var(--space-lg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            transition: transform 0.3s var(--ease-spring), border-color 0.3s, box-shadow 0.3s;
            position: relative;
            overflow: hidden;
        }
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--primary-glow), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            border-color: var(--border-active);
            box-shadow: var(--shadow-md);
        }
        .stat-card:hover::before { opacity: 1; }
        .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-sm);
            display: grid;
            place-items: center;
            font-size: 1.4rem;
            margin-bottom: var(--space-sm);
        }
        .stat-card:nth-child(1) .stat-icon { background: rgba(99, 102, 241, 0.15); color: var(--primary-light); }
        .stat-card:nth-child(2) .stat-icon { background: rgba(6, 182, 212, 0.15); color: #67e8f9; }
        .stat-card:nth-child(3) .stat-icon { background: rgba(34, 197, 94, 0.15); color: #86efac; }
        .stat-number {
            font-size: 2.1rem;
            font-weight: 700;
            margin-bottom: 2px;
            letter-spacing: -0.02em;
            line-height: 1.1;
        }
        .stat-label {
            font-size: 0.88rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        /* ========== 工具栏 ========== */
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--space-lg);
            gap: var(--space-md);
            flex-wrap: wrap;
        }
        .section-title {
            font-size: 1.35rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: var(--space-sm);
            letter-spacing: -0.01em;
        }
        .section-title-count {
            font-size: 0.85rem;
            color: var(--text-dim);
            font-weight: 500;
            padding: 3px 10px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-full);
        }
        .toolbar-right {
            display: flex;
            gap: var(--space-sm);
            align-items: center;
            flex-wrap: wrap;
        }
        .search-box {
            position: relative;
            width: 280px;
        }
        .search-box input {
            width: 100%;
            padding: 11px 16px 11px 42px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text);
            font-size: 0.92rem;
            font-family: inherit;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            backdrop-filter: blur(12px);
        }
        .search-box input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
            background: var(--surface-hover);
        }
        .search-box input::placeholder { color: var(--text-dim); }
        .search-box svg {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            color: var(--text-dim);
            pointer-events: none;
        }

        /* ========== 主题列表 ========== */
        .theme-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: var(--space-lg);
        }

        /* 骨架屏 */
        .skeleton-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            backdrop-filter: blur(12px);
        }
        .skeleton-preview {
            height: 200px;
            background: linear-gradient(90deg, var(--surface-solid) 0%, rgba(51,65,85,0.6) 50%, var(--surface-solid) 100%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
        }
        .skeleton-content { padding: var(--space-md); }
        .skeleton-line {
            height: 14px;
            background: var(--surface-solid);
            border-radius: var(--radius-xs);
            margin-bottom: var(--space-sm);
            background: linear-gradient(90deg, var(--surface-solid) 0%, rgba(51,65,85,0.6) 50%, var(--surface-solid) 100%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
        }
        .skeleton-line:nth-child(1) { width: 60%; }
        .skeleton-line:nth-child(2) { width: 100%; height: 12px; }
        .skeleton-line:nth-child(3) { width: 80%; height: 12px; }
        @keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        /* 主题卡片 */
        .theme-item {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            transition: transform 0.4s var(--ease-spring), box-shadow 0.4s var(--ease-smooth), border-color 0.3s;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.5s var(--ease-out) forwards;
        }
        @keyframes fadeInUp {
            to { opacity: 1; transform: translateY(0); }
        }
        .theme-item:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
            border-color: var(--border-active);
        }
        .theme-preview-wrap {
            position: relative;
            overflow: hidden;
            height: 200px;
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        }
        .theme-preview {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s var(--ease-out);
            display: block;
        }
        .theme-item:hover .theme-preview { transform: scale(1.06); }
        .preview-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(11, 17, 32, 0.95) 0%, transparent 60%);
            opacity: 0;
            transition: opacity 0.3s;
        }
        .theme-item:hover .preview-overlay { opacity: 1; }
        .theme-version {
            position: absolute;
            top: var(--space-sm);
            right: var(--space-sm);
            background: rgba(11, 17, 32, 0.75);
            border: 1px solid var(--border);
            padding: 4px 10px;
            border-radius: var(--radius-full);
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text);
            backdrop-filter: blur(8px);
            font-family: 'JetBrains Mono', monospace;
        }
        .theme-content {
            padding: var(--space-md);
            display: flex;
            flex-direction: column;
            flex: 1;
        }
        .theme-name {
            font-size: 1.15rem;
            font-weight: 600;
            margin-bottom: var(--space-xs);
            color: var(--text);
            letter-spacing: -0.01em;
        }
        .theme-description {
            color: var(--text-secondary);
            font-size: 0.9rem;
            line-height: 1.65;
            flex: 1;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin-bottom: var(--space-md);
        }
        .theme-meta {
            padding-top: var(--space-sm);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.82rem;
            color: var(--text-muted);
        }
        .theme-author {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 500;
        }
        .theme-author::before {
            content: '';
            width: 6px;
            height: 6px;
            background: var(--success);
            border-radius: 50%;
            box-shadow: 0 0 6px var(--success);
        }
        .theme-short {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.78rem;
            color: var(--text-dim);
        }
        .theme-actions {
            margin-top: var(--space-md);
            display: flex;
            gap: var(--space-sm);
        }
        .theme-btn {
            flex: 1;
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            text-align: center;
            transition: all 0.25s var(--ease-smooth);
            cursor: pointer;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-family: inherit;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            box-shadow: 0 4px 12px -2px var(--primary-glow);
        }
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px -4px var(--primary-glow);
        }
        .btn-primary:active { transform: translateY(0); }
        .btn-secondary {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text);
            border: 1px solid var(--border);
        }
        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--border-hover);
        }
        .theme-btn svg { flex-shrink: 0; }

        /* 预览图失败占位 */
        .preview-fallback {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: var(--text-dim);
            font-size: 0.85rem;
            gap: 8px;
        }

        /* ========== 页脚 ========== */
        footer {
            margin-top: var(--space-xl);
            padding-top: var(--space-lg);
            border-top: 1px solid var(--border);
            text-align: center;
            color: var(--text-muted);
            font-size: 0.88rem;
            line-height: 1.8;
        }
        footer a {
            color: var(--primary-light);
            text-decoration: none;
            transition: color 0.2s;
        }
        footer a:hover { color: var(--text); }

        /* ========== 状态提示 ========== */
        .state {
            text-align: center;
            padding: 80px 20px;
            color: var(--text-secondary);
            grid-column: 1 / -1;
        }
        .state-icon {
            font-size: 2.5rem;
            margin-bottom: var(--space-sm);
            opacity: 0.6;
        }
        .state-text { font-size: 0.95rem; }

        .spinner {
            width: 36px;
            height: 36px;
            border: 3px solid var(--border);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto var(--space-sm);
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ========== Toast 通知 ========== */
        .toast-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
        }
        .toast {
            background: var(--surface-solid);
            border: 1px solid var(--border-hover);
            border-radius: var(--radius-sm);
            padding: 12px 16px;
            color: var(--text);
            font-size: 0.9rem;
            box-shadow: var(--shadow-md);
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 220px;
            backdrop-filter: blur(12px);
            animation: toastIn 0.3s var(--ease-spring) forwards;
            pointer-events: auto;
        }
        .toast.success { border-left: 3px solid var(--success); }
        .toast.error { border-left: 3px solid #ef4444; }
        .toast.removing { animation: toastOut 0.3s var(--ease-smooth) forwards; }
        @keyframes toastIn {
            from { transform: translateX(120%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes toastOut {
            to { transform: translateX(120%); opacity: 0; }
        }
        .toast-icon { font-size: 1.1rem; }

        /* ========== 回到顶部 ========== */
        .back-to-top {
            position: fixed;
            bottom: 24px;
            left: 24px;
            width: 44px;
            height: 44px;
            background: var(--surface-solid);
            border: 1px solid var(--border-hover);
            border-radius: var(--radius-full);
            color: var(--text);
            cursor: pointer;
            display: grid;
            place-items: center;
            opacity: 0;
            visibility: hidden;
            transform: translateY(20px);
            transition: all 0.3s var(--ease-spring);
            backdrop-filter: blur(12px);
            z-index: 999;
            box-shadow: var(--shadow-md);
        }
        .back-to-top.visible {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        .back-to-top:hover {
            background: var(--primary);
            border-color: var(--primary);
            transform: translateY(-2px);
            box-shadow: var(--shadow-glow);
        }

        /* ========== 响应式 ========== */
        @media (max-width: 1024px) {
            .theme-list { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
        }
        @media (max-width: 768px) {
            .container { padding: 20px 16px 60px; }
            header { flex-direction: column; align-items: flex-start; }
            .data-source { width: 100%; }
            .toolbar { flex-direction: column; align-items: stretch; }
            .toolbar-right { width: 100%; }
            .search-box { width: 100%; }
            .theme-list { grid-template-columns: 1fr; }
            .stats { grid-template-columns: 1fr; }
            .brand-text h1 { font-size: 1.6rem; }
            .toast-container { left: 16px; right: 16px; bottom: 16px; }
            .toast { min-width: 0; }
            .back-to-top { left: 16px; bottom: 16px; }
        }
        @media (max-width: 480px) {
            .theme-actions { flex-direction: column; }
            .stat-card { padding: var(--space-sm) var(--space-md); }
            .stat-number { font-size: 1.7rem; }
        }

        /* 减少动画偏好 */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
            body::before { animation: none; }
        }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <header>
            <div class="brand">
                <div class="logo">🎨</div>
                <div class="brand-text">
                    <h1>Komari Market</h1>
                    <p>自动同步上游仓库，国内加速访问</p>
                </div>
            </div>
            <button class="theme-toggle" id="theme-toggle" aria-label="切换主题">
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                </button>
        </header>

        <section class="data-source" aria-label="主题源地址">
            <div class="data-source-header">
                <div class="data-source-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>
                </div>
                <div class="data-source-meta">
                    <div class="data-source-title">
                        <span class="data-source-dot"></span>
                        Komari 主题源
                    </div>
                    <div class="data-source-desc">将此地址添加到 Komari 设置中，即可浏览和安装主题</div>
                </div>
            </div>
            <div class="data-source-row">
                <code class="data-source-url" id="source-url">https://komari-market.mikus.ink/v1.json</code>
                <button class="btn-copy" id="btn-copy" aria-label="复制主题源地址">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    <span id="copy-text">复制</span>
                </button>
            </div>
        </section>

        <section class="stats" aria-label="统计信息">
            <div class="stat-card">
                <div class="stat-icon">📦</div>
                <div class="stat-number" id="theme-count">-</div>
                <div class="stat-label">可用主题</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🕐</div>
                <div class="stat-number" id="sync-time">-</div>
                <div class="stat-label">最后同步</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🚀</div>
                <div class="stat-number">CDN</div>
                <div class="stat-label">国内加速</div>
            </div>
        </section>

        <div class="toolbar">
            <h2 class="section-title">
                🌈 主题列表
                <span class="section-title-count" id="visible-count">-</span>
            </h2>
            <div class="toolbar-right">
                <div class="search-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                    <input type="text" id="search-input" placeholder="搜索主题名称、作者..." aria-label="搜索主题">
                </div>
            </div>
        </div>

        <main class="theme-list" id="theme-list">
            <div class="state">
                <div class="spinner"></div>
                <div class="state-text">正在加载主题...</div>
            </div>
        </main>

        <footer>
            <p>数据来源：<a href="https://github.com/komari-monitor/theme-market" target="_blank" rel="noopener">komari-monitor/theme-market</a> · 托管于 <a href="https://cloud.tencent.com/product/eo" target="_blank" rel="noopener">EdgeOne Pages</a></p>
        </footer>
    </div>

    <button class="back-to-top" id="back-to-top" aria-label="回到顶部">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg>
    </button>

    <div class="toast-container" id="toast-container" aria-live="polite"></div>

    <script>
        let allThemes = [];

        // ========== 工具函数 ==========
        function formatRelativeTime(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            const now = new Date();
            const diff = now - date;
            if (diff < 0) return '刚刚';
            if (diff < 60000) return '刚刚';
            if (diff < 3600000) return Math.floor(diff / 60000) + ' 分钟前';
            if (diff < 86400000) return Math.floor(diff / 3600000) + ' 小时前';
            if (diff < 2592000000) return Math.floor(diff / 86400000) + ' 天前';
            return date.toLocaleDateString('zh-CN');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            const icon = type === 'success' ? '✓' : type === 'error' ? '✗' : 'ℹ';
            toast.innerHTML = `<span class="toast-icon">${icon}</span><span>${escapeHtml(message)}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('removing');
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        // ========== 骨架屏 ==========
        function renderSkeleton(count = 6) {
            const themeList = document.getElementById('theme-list');
            let html = '';
            for (let i = 0; i < count; i++) {
                html += `
                    <div class="skeleton-card">
                        <div class="skeleton-preview"></div>
                        <div class="skeleton-content">
                            <div class="skeleton-line"></div>
                            <div class="skeleton-line"></div>
                            <div class="skeleton-line"></div>
                        </div>
                    </div>
                `;
            }
            themeList.innerHTML = html;
        }

        // ========== 渲染主题 ==========
        function renderThemes(themes) {
            const themeList = document.getElementById('theme-list');
            const visibleCount = document.getElementById('visible-count');
            visibleCount.textContent = `${themes.length} / ${allThemes.length}`;

            if (themes.length === 0) {
                themeList.innerHTML = `
                    <div class="state">
                        <div class="state-icon">🔍</div>
                        <div class="state-text">未找到匹配的主题</div>
                    </div>
                `;
                return;
            }

            themeList.innerHTML = '';
            themes.forEach((theme, index) => {
                const name = theme.name['zh-CN'] || theme.name || '未命名主题';
                const description = theme.description['zh-CN'] || theme.description || '暂无描述';
                const author = theme.author['zh-CN'] || theme.author || '匿名';
                const previewUrl = theme.preview;
                const downloadUrl = theme.download;
                const short = theme.short || '';
                const version = theme.version || '';

                const themeCard = document.createElement('article');
                themeCard.className = 'theme-item';
                themeCard.style.animationDelay = `${Math.min(index * 40, 400)}ms`;
                themeCard.innerHTML = `
                    <div class="theme-preview-wrap">
                        <img src="${escapeHtml(previewUrl)}" alt="${escapeHtml(name)}" class="theme-preview" loading="lazy" onerror="this.style.display='none'; this.parentElement.querySelector('.preview-fallback')?.style.removeProperty('display')">
                        <div class="preview-fallback" style="display:none">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
                            <span>预览图加载失败</span>
                        </div>
                        <div class="preview-overlay"></div>
                        ${version ? `<div class="theme-version">v${escapeHtml(version)}</div>` : ''}
                    </div>
                    <div class="theme-content">
                        <div class="theme-name">${escapeHtml(name)}</div>
                        <div class="theme-description">${escapeHtml(description)}</div>
                        <div class="theme-meta">
                            <span class="theme-author">${escapeHtml(author)}</span>
                            ${short ? `<span class="theme-short">${escapeHtml(short)}</span>` : ''}
                        </div>
                        <div class="theme-actions">
                            <a href="${escapeHtml(theme.url || '#')}" target="_blank" rel="noopener" class="theme-btn btn-secondary" aria-label="查看 ${escapeHtml(name)} 详情">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
                                详情
                            </a>
                            <a href="${escapeHtml(downloadUrl || '#')}" class="theme-btn btn-primary" download aria-label="下载 ${escapeHtml(name)}">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                下载
                            </a>
                        </div>
                    </div>
                `;

                // 下载按钮点击提示
                const downloadBtn = themeCard.querySelector('.btn-primary');
                downloadBtn.addEventListener('click', () => {
                    showToast(`开始下载：${name}`, 'success');
                });

                themeList.appendChild(themeCard);
            });
        }

        // ========== 搜索过滤 ==========
        function filterThemes(query) {
            const q = query.toLowerCase().trim();
            if (!q) return allThemes;
            return allThemes.filter(theme => {
                const name = (theme.name['zh-CN'] || theme.name || '').toLowerCase();
                const desc = (theme.description['zh-CN'] || theme.description || '').toLowerCase();
                const author = (theme.author['zh-CN'] || theme.author || '').toLowerCase();
                const short = (theme.short || '').toLowerCase();
                return name.includes(q) || desc.includes(q) || author.includes(q) || short.includes(q);
            });
        }

        // ========== 加载主题 ==========
        async function loadThemes() {
            renderSkeleton(6);
            try {
                const response = await fetch('./v1.json');
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();

                allThemes = data.themes || [];

                document.getElementById('theme-count').textContent = allThemes.length;
                document.getElementById('sync-time').textContent = formatRelativeTime(data.updated_at);

                renderThemes(allThemes);

                // 搜索防抖
                let searchTimer;
                document.getElementById('search-input').addEventListener('input', (e) => {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(() => {
                        renderThemes(filterThemes(e.target.value));
                    }, 150);
                });

                console.log(`✅ 加载了 ${allThemes.length} 个主题`);
            } catch (error) {
                console.error('加载主题失败:', error);
                document.getElementById('theme-list').innerHTML = `
                    <div class="state">
                        <div class="state-icon">⚠️</div>
                        <div class="state-text">加载失败，请刷新页面重试</div>
                    </div>
                `;
                showToast('加载主题失败', 'error');
            }
        }

        // ========== 回到顶部 ==========
        function initBackToTop() {
            const btn = document.getElementById('back-to-top');
            window.addEventListener('scroll', () => {
                btn.classList.toggle('visible', window.scrollY > 400);
            }, { passive: true });
            btn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        // ========== 主题切换 ==========
        function initTheme() {
            const toggle = document.getElementById('theme-toggle');
            const root = document.documentElement;

            // 读取存储的主题偏好，默认跟随系统
            const saved = localStorage.getItem('theme');
            if (saved === 'light') {
                root.setAttribute('data-theme', 'light');
            } else if (saved === 'dark') {
                root.removeAttribute('data-theme');
            } else {
                // 无存储值或非预期值，回退到系统主题偏好
                localStorage.removeItem('theme');
                if (window.matchMedia('(prefers-color-scheme: light)').matches) {
                    root.setAttribute('data-theme', 'light');
                } else {
                    root.removeAttribute('data-theme');
                }
            }

            // 更新 meta theme-color
            function updateMetaColor() {
                const isLight = root.getAttribute('data-theme') === 'light';
                document.querySelector('meta[name="theme-color"]').content = isLight ? '#f8fafc' : '#0f172a';
            }
            updateMetaColor();

            toggle.addEventListener('click', () => {
                const isLight = root.getAttribute('data-theme') === 'light';
                if (isLight) {
                    root.removeAttribute('data-theme');
                    localStorage.setItem('theme', 'dark');
                } else {
                    root.setAttribute('data-theme', 'light');
                    localStorage.setItem('theme', 'light');
                }
                updateMetaColor();
            });
        }

        // ========== 复制主题源 ==========
        function initCopy() {
            const btn = document.getElementById('btn-copy');
            const copyText = document.getElementById('copy-text');
            const url = document.getElementById('source-url').textContent;

            btn.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(url);
                    btn.classList.add('copied');
                    copyText.textContent = '已复制';
                    showToast('主题源地址已复制到剪贴板', 'success');
                    setTimeout(() => {
                        btn.classList.remove('copied');
                        copyText.textContent = '复制';
                    }, 2000);
                } catch {
                    // fallback
                    const ta = document.createElement('textarea');
                    ta.value = url;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                    btn.classList.add('copied');
                    copyText.textContent = '已复制';
                    showToast('主题源地址已复制到剪贴板', 'success');
                    setTimeout(() => {
                        btn.classList.remove('copied');
                        copyText.textContent = '复制';
                    }, 2000);
                }
            });
        }

        // ========== 初始化 ==========
        window.addEventListener('DOMContentLoaded', () => {
            initTheme();
            initCopy();
            loadThemes();
            initBackToTop();
        });
    </script>
</body>
</html>
